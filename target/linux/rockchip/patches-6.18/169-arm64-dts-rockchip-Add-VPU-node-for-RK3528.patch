From 87ba99ee00439601835d97802dd8cab9cee1db1d Mon Sep 17 00:00:00 2001
From: Jonas Karlman <jonas@kwiboo.se>
Date: Wed, 5 Mar 2025 20:27:09 +0000
Subject: [PATCH 169/175] arm64: dts: rockchip: Add VPU node for RK3528

Signed-off-by: Jonas Karlman <jonas@kwiboo.se>
---
 arch/arm64/boot/dts/rockchip/rk3528.dtsi | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -763,6 +763,29 @@
 			status = "disabled";
 		};
 
+		vpu: video-codec@ff7c0000 {
+			compatible = "rockchip,rk3528-vpu",
+				     "rockchip,rk3568-vpu";
+			reg = <0x0 0xff7c0000 0x0 0x800>;
+			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+			clock-names = "aclk", "hclk";
+			interrupts = <GIC_SPI 98 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "vdpu";
+			iommus = <&vpu_mmu>;
+			power-domains = <&power RK3528_PD_VPU>;
+		};
+
+		vpu_mmu: iommu@ff7c0800 {
+			compatible = "rockchip,rk3528-iommu",
+				     "rockchip,rk3568-iommu";
+			reg = <0x0 0xff7c0800 0x0 0x40>;
+			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+			clock-names = "aclk", "iface";
+			interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <0>;
+			power-domains = <&power RK3528_PD_VPU>;
+		};
+
 		spi0: spi@ff9c0000 {
 			compatible = "rockchip,rk3528-spi",
 				     "rockchip,rk3066-spi";
